# Copia este archivo como .env.local y llena los valores. .env.local no se sube a GitHub.
#
# Huella SHA-256 de la contraseña de administración (M-03). Se calcula con:
#   node -e "console.log(require('crypto').createHash('sha256').update('te-admin:' + 'TU_CONTRASEÑA').digest('hex'))"
# Si se deja vacía, el panel de inventario no permite entrar.
VITE_ADMIN_PASSWORD_SHA256=

# Contraseña en texto que usa la prueba de regresión (npm run e2e) para entrar al panel.
E2E_ADMIN_PASSWORD=
